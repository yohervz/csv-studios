{
    "compilerOptions": {
        "module": "Node16",
        "target": "ES2022",
        "outDir": "out",
        "lib": ["ES2022", "DOM"],
        "types": ["node", "mocha"],
        "sourceMap": true,
        "rootDir": "src",
        "strict": true,
        "esModuleInterop": true
    },
    "include": ["src/**/*", "media"],
    "exclude": ["node_modules", ".vscode-test", "media"]
}